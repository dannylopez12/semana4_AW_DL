@model Registro
@{
    ViewData["Title"] = "Registros";
    var registros = ViewBag.Registros as List<Registro> ?? new List<Registro>();
    var clubes = ViewBag.Clubes as List<Club> ?? new List<Club>();
    var miembros = ViewBag.Miembros as List<Miembro> ?? new List<Miembro>();
}
<section>
    <h2>Registrar miembro en un club</h2>
    @if (clubes.Count == 0 || miembros.Count == 0)
    {
        <p>Primero debe registrar al menos un club y un miembro.</p>
    }
    else
    {
        <form asp-action="Guardar" method="post">
            <div class="campos">
                <div>
                    <label asp-for="ClubId"></label>
                    <select asp-for="ClubId">
                        <option value="0">Seleccione</option>
                        @foreach (var c in clubes)
                        {
                            <option value="@c.ClubId">@c.Nombre (@c.Deporte)</option>
                        }
                    </select>
                    <span asp-validation-for="ClubId" class="error"></span>
                </div>
                <div>
                    <label asp-for="MiembroId"></label>
                    <select asp-for="MiembroId">
                        <option value="0">Seleccione</option>
                        @foreach (var m in miembros)
                        {
                            <option value="@m.MiembroId">@m.Apellido @m.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="MiembroId" class="error"></span>
                </div>
                <div>
                    <label asp-for="FechaRegistro"></label>
                    <input asp-for="FechaRegistro">
                    <span asp-validation-for="FechaRegistro" class="error"></span>
                </div>
            </div>
            <button type="submit">Registrar</button>
        </form>
    }
</section>

<section>
    <h2>Lista de registros</h2>
    @if (registros.Count == 0)
    {
        <p>No hay registros.</p>
    }
    else
    {
        <div class="tabla">
            <table>
                <tr>
                    <th>Club</th>
                    <th>Deporte</th>
                    <th>Miembro</th>
                    <th>Email</th>
                    <th>Fecha de registro</th>
                    <th>Acciones</th>
                </tr>
                @foreach (var r in registros)
                {
                    <tr>
                        <td>@r.Club</td>
                        <td>@r.Deporte</td>
                        <td>@r.Miembro</td>
                        <td>@r.Email</td>
                        <td>@r.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                        <td class="acciones">
                            <form asp-action="Eliminar" asp-route-id="@r.RegistroId" method="post" onsubmit="return confirm('¿Desea eliminar este registro?');">
                                <button type="submit">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        </div>
    }
</section>
